{
  "name": "@veilcircle/contract",
  "version": "1.0.0",
  "description": "VeilCircle Compact smart contract and zero-knowledge circuits on Midnight blockchain",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "compact:compile": "bash compile.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "wallet:address": "tsx scripts/wallet-address.ts",
    "deploy": "tsx scripts/deploy.ts --network preview",
    "deploy:preview": "tsx scripts/deploy.ts --network preview",
    "deploy:preprod": "tsx scripts/deploy.ts --network preprod",
    "verify:deployment": "node scripts/verify-deployment.js"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "privacy",
    "zk-snark",
    "veilcircle"
  ],
  "author": "VeilCircle Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.34.8"
  }
}
